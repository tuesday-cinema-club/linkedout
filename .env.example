# =============================================================================
# LinkedIn Cybersecurity Bot - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your API keys and credentials
#
# IMPORTANT: Never commit .env to git - it contains sensitive credentials!
# =============================================================================

# -----------------------------------------------------------------------------
# AI Provider API Keys
# -----------------------------------------------------------------------------

# Google Gemini API Key (get from https://aistudio.google.com/apikey)
# Used for: Content generation, research (with web search), image generation
VITE_GEMINI_API_KEY=

# Claude API Key (get from https://console.anthropic.com/)
# Used for: Alternative content generation (professional writing quality)
VITE_CLAUDE_API_KEY=

# -----------------------------------------------------------------------------
# LinkedIn Credentials
# -----------------------------------------------------------------------------

# LinkedIn OAuth Access Token
# Get this by creating a LinkedIn app and using OAuth 2.0 flow
# Guide: https://docs.microsoft.com/en-us/linkedin/shared/authentication/authentication
# Scopes needed: w_member_social (to post content)
VITE_LINKEDIN_ACCESS_TOKEN=

# LinkedIn Person URN
# Format: urn:li:person:XXXXXXXXX
# Find this by calling: https://api.linkedin.com/v2/me with your access token
VITE_LINKEDIN_PERSON_URN=

# -----------------------------------------------------------------------------
# Service URLs
# -----------------------------------------------------------------------------

# LinkedIn API Proxy URL (leave as default for local dev)
VITE_LINKEDIN_PROXY_URL=http://localhost:4000/api/linkedin

# Frontend Origin (for CORS)
FRONTEND_ORIGIN=http://localhost:3000

# Allowed hosts for CORS
VITE_ALLOWED_HOSTS=localhost:3000,localhost:4000

# -----------------------------------------------------------------------------
# Image Generation - Local GPU (Optional)
# -----------------------------------------------------------------------------

# Stable Diffusion WebUI API URL
# Only needed if using local GPU image generation
# Install: https://github.com/AUTOMATIC1111/stable-diffusion-webui
# Run with: ./webui.sh --api --listen
VITE_SD_API_URL=http://localhost:7860

# -----------------------------------------------------------------------------
# Bot Configuration
# -----------------------------------------------------------------------------

# AI Provider: "gemini" or "claude"
BOT_AI_PROVIDER=gemini

# Image Generation Provider: "gemini" or "local-sd"
BOT_IMAGE_PROVIDER=gemini

# Enable/disable automatic posting
BOT_AUTO_POSTING_ENABLED=false

# Daily short post (150-300 words about recent cyber news)
BOT_DAILY_POST_ENABLED=true
BOT_DAILY_POST_TIME=09:00

# Weekly long article (600-1000 words, in-depth analysis)
BOT_WEEKLY_POST_ENABLED=true
BOT_WEEKLY_POST_DAY=1
BOT_WEEKLY_POST_TIME=10:00

# -----------------------------------------------------------------------------
# Docker Configuration (for deployment)
# -----------------------------------------------------------------------------

# Node environment
NODE_ENV=production

# Logging level
LOG_LEVEL=info

# =============================================================================
# Setup Instructions:
# =============================================================================
#
# 1. GEMINI API KEY:
#    - Go to https://aistudio.google.com/apikey
#    - Create/copy your API key
#    - Paste it into VITE_GEMINI_API_KEY above
#
# 2. CLAUDE API KEY (optional, if you want to use Claude):
#    - Go to https://console.anthropic.com/
#    - Create an API key
#    - Paste it into VITE_CLAUDE_API_KEY above
#
# 3. LINKEDIN CREDENTIALS:
#    a. Create LinkedIn App:
#       - Go to https://www.linkedin.com/developers/apps
#       - Create new app
#       - Add "Sign In with LinkedIn using OpenID Connect" product
#       - Add "Share on LinkedIn" product (requires verification)
#
#    b. Get Access Token:
#       - Use OAuth 2.0 Authorization Code Flow
#       - Scopes: openid, profile, email, w_member_social
#       - Tool: https://www.linkedin.com/developers/tools/oauth
#
#    c. Get Person URN:
#       - Use your access token to call:
#         curl -H "Authorization: Bearer YOUR_TOKEN" \
#              https://api.linkedin.com/v2/userinfo
#       - Copy the "sub" field (format: urn:li:person:XXXXXXX)
#
# 4. STABLE DIFFUSION (optional, for local image generation):
#    - Install AUTOMATIC1111 WebUI:
#      https://github.com/AUTOMATIC1111/stable-diffusion-webui
#    - Download a model (Stable Diffusion 1.5 or SDXL)
#    - Run with: ./webui.sh --api --listen
#    - Set VITE_SD_API_URL to http://localhost:7860
#
# =============================================================================
# Running the Bot:
# =============================================================================
#
# Local Development:
#   npm install
#   npm start
#
# Docker:
#   docker-compose up -d
#
# Access:
#   Frontend UI: http://localhost:3000
#   API Proxy:   http://localhost:4000
#
# =============================================================================
